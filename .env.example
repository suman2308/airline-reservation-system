# =============================================
# AeroBook – Environment Configuration
# =============================================
# Copy this file to .env in the project root and fill in your values.
# .env is excluded from Git (see .gitignore).

# ─── Database ────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=aerobook_db
# Optional: leave empty to auto-detect BASE_URL from the current request
# (works on localhost, subfolder installs, and shared hosting).
BASE_URL=

# ─── Application ──────────────────────────────
SITE_NAME=AeroBook
SITE_TAGLINE=Smart, Fast and Easy Flight Booking Platform
SESSION_TIMEOUT_MINUTES=30
REQUIRE_EMAIL_VERIFICATION=false

# ─── SMTP (Optional — emails log to file by default) ───
MAIL_MODE=log
MAIL_FROM=noreply@aerobook.in
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=tls

# ─── External APIs ───────────────────────────
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_ENABLED=false

# ─── Docker (set to "true" when running in Docker) ───
IS_DOCKER=false

# ─── Maintenance Mode ────────────────────────
MAINTENANCE_MODE=false
